# Copy to .env.local and fill in.
#
# Hosted Supabase project (Dashboard -> Project Settings -> API):
#   NEXT_PUBLIC_SUPABASE_URL      = Project URL, e.g. https://abcdefgh.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = the "anon public" key
#   SUPABASE_SERVICE_ROLE_KEY     = the "service_role" key. Server only: it
#                                   bypasses RLS, so it must never be prefixed
#                                   NEXT_PUBLIC_ or reach the browser.
#
# Local stack instead: `pnpm db:start` prints all three.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit (Dashboard -> Developer options -> API keys). Holds catalog images
# and payment proofs.
#
#   NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT = URL endpoint, e.g. https://ik.imagekit.io/abc123
#   IMAGEKIT_PRIVATE_KEY              = the private key. Server only: it grants
#                                       full control of the media library and
#                                       signs private proof URLs, so it must
#                                       never be prefixed NEXT_PUBLIC_.
#
# The public key is not needed: uploads are proxied through the server, so the
# browser never talks to ImageKit directly.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-endpoint
IMAGEKIT_PRIVATE_KEY=

# Only used to push migrations to the hosted project (`pnpm db:link`,
# `pnpm db:push`). Found in the dashboard URL: /project/<ref>.
SUPABASE_PROJECT_REF=

# Direct Postgres connection, used ONLY to apply migrations (`pnpm db:push`).
# This is the database password, which is NOT the same as the API keys above.
#
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Copy it verbatim; it already contains the right pooler host and port. Newer
# projects have no IPv4 on db.<ref>.supabase.co, so the pooler host is the only
# route that resolves. Use the session-mode string (port 5432) — the
# transaction pooler on 6543 cannot run the DDL in these migrations.
#
# Percent-encode any of : / ? # [ ] @ in the password, or the URI will not parse.
# Never commit this. .env.local is gitignored; .env.example is not.
SUPABASE_DB_URL=
